// ntx-guestnet WIT (library-only for now)
//
// Goal: define a stable interface surface for guest networking that can be used by
// components, while keeping host integration packet-primitive-only.
//
// This file is intentionally minimal: it defines the types and API shape that
// match the current Rust library (UDP + RAW IPv4 send with set-raw-protocol).
// Component glue (wit-bindgen, worlds, etc.) will be added later.

package ntx:guestnet@0.1.0;

interface types {
    /// IPv4 address in network byte order.
    type ipv4-addr = tuple<u8, u8, u8, u8>;

    /// MAC address.
    type mac-addr = tuple<u8, u8, u8, u8, u8, u8>;

    /// Ethertype (big-endian) for Ethernet frames.
    type ethertype = u16;

    /// Transport protocol selection.
    variant transport-proto {
        udp,
        raw,
        eth,
    }

    /// v4 endpoint.
    record endpoint-v4 {
        ip: ipv4-addr,
        port: u16,
    }

    /// Datagram returned from recv.
    record datagram-v4 {
        src: endpoint-v4,
        dst: endpoint-v4,
        payload: list<u8>,
    }

    /// Socket kind (protocol family).
    variant socket-kind {
        udp,
        raw,
        eth,
    }

    /// L2 endpoint for Ethernet-like sockets.
    record endpoint-eth {
        src: mac-addr,
        dst: mac-addr,
        ethertype: ethertype,
    }

    /// Ethernet frame returned from recv.
    record frame-eth {
        src: mac-addr,
        dst: mac-addr,
        ethertype: ethertype,
        payload: list<u8>,
    }

    /// Errors are intentionally structured and non-allocating.
    variant error {
        would-block,
        invalid-arg,
        invalid-state,
        not-found,
        unsupported,
        internal,
    }
}

/// Host integration primitives.
///
/// These are intentionally packet-primitive-only (no sockets).
interface host {
    use types.{error};

    /// Host event kinds.
    variant event-kind {
        packet,
        timer,
        socket,
    }

    /// Result from poller.
    record event {
        kind: event-kind,
    }

    /// Shared memory mapping provided by the host.
    ///
    /// The intent is zero-copy: the guest uses `wasm32` linear memory + canonical ABI
    /// lowering/lifting to access regions of this mapping without forcing a host-side
    /// payload copy per packet.
    ///
    /// Notes:
    /// - Some host implementations may still copy internally; this is a contract
    ///   boundary, not a performance guarantee.
    /// - The mapping is treated as read-only by the guest.
    resource sharedmem {
        /// Copy fallback (debug / compatibility). Not on the hot path.
        read: func(offset: u32, len: u32) -> result<list<u8>, error>;
    }

    /// A borrowed view into host-provided shared memory.
    ///
    /// This is the *zero-copy oriented* representation used by the datapath.
    record packet-slice {
        shm: sharedmem,
        offset: u32,
        len: u32,
    }

    /// Packet descriptor referencing `packet-slice` (payload) plus metadata.
    record packet-desc {
        payload: packet-slice,

        /// 4 == IPv4
        l3-proto: u8,
        /// e.g. 17 == UDP
        l4-proto: u8,

        flow-hash: u64,
    }

    /// Non-blocking: returns at most one descriptor when a packet is available.
    poll-packet: func() -> option<packet-desc>;

    /// Non-blocking poller.
    ///
    /// The guest controls its own loop and should not rely on the host to block forever.
    poll-oneoff: func(interests: list<event-kind>) -> list<event>;

    /// Submit a complete L2 frame.
    tx-submit: func(frame: list<u8>) -> result<(), error>;

    /// Submit a complete IPv4 packet starting at the IPv4 header.
    ///
    /// Host performs L2 resolution/encapsulation.
    tx-submit-l3-ipv4: func(packet: list<u8>) -> result<(), error>;
}

interface sockets {
    use types.{endpoint-v4, datagram-v4, endpoint-eth, frame-eth, socket-kind, error};

    /// Opaque socket handle.
    type socket = u32;

    /// Create a socket.
    create: func(kind: socket-kind) -> result<socket, error>;

    /// Bind local address.
    bind-v4: func(s: socket, local: endpoint-v4) -> result<(), error>;

    /// Connect to remote endpoint.
    connect-v4: func(s: socket, remote: endpoint-v4) -> result<(), error>;

    /// Set protocol number for RAW socket. Must be called before send on RAW.
    set-raw-protocol: func(s: socket, proto: u8) -> result<(), error>;

    /// Non-blocking receive.
    recv-v4: func(s: socket) -> result<datagram-v4, error>;

    /// Non-blocking receive for ETH sockets.
    ///
    /// Placeholder: current Rust library may return `unsupported`.
    recv-eth: func(s: socket) -> result<frame-eth, error>;

    /// Non-blocking send.
    ///
    /// For UDP: payload goes to (connected) 4-tuple.
    /// For RAW: payload is IPv4 payload only. IPv4 header is generated internally
    /// using the socket's bind/connect addresses and raw protocol.
    send: func(s: socket, payload: list<u8>) -> result<u32, error>;

    /// Non-blocking send for ETH sockets.
    ///
    /// Placeholder: current Rust library may return `unsupported`.
    send-eth: func(s: socket, ep: endpoint-eth, payload: list<u8>) -> result<u32, error>;
}

world guestnet {
    import host;
    export sockets;
}
