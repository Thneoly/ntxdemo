package scheduler:executor@0.1.0;

use scheduler:executor-types/types@0.1.0 as exec-types;

interface context-helper {
    use exec-types.{action-context, action-def, wbs-task, wbs-edge};

    /// Queue an event to register a new action
    register-action: func(ctx: action-context, action: action-def);

    /// Queue an event to add a task
    add-task: func(ctx: action-context, task: wbs-task);

    /// Queue an event to remove a task
    remove-task: func(ctx: action-context, task-id: string);

    /// Queue an event to update a task
    update-task: func(ctx: action-context, task: wbs-task);

    /// Queue an event to add an edge
    add-edge: func(ctx: action-context, from-id: string, edge: wbs-edge);

    /// Queue an event to remove an edge
    remove-edge: func(ctx: action-context, from-id: string, target: string);

    /// Retrieve the latest snapshot of a task, if any
    get-task: func(ctx: action-context, task-id: string) -> option<wbs-task>;
}

interface component-api {
    use exec-types.{action-def, action-outcome, action-context};

    execute-action: func(action: action-def, ctx: action-context) -> result<action-outcome, string>;
}

/// Action execution runtime and event model
world scheduler-executor {
    export exec-types;
    export component-api;
    import context-helper;
}
