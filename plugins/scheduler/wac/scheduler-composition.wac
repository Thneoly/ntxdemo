// WAC composition that wires scheduler, actions-http, and core-libs together.
// 放到deps文件夹内  ## wac compose wac/scheduler-composition.wac --deps-dir wac/deps -o wac/scheduler-composed.wasm
package scheduler:composition@0.1.0;

let core = new scheduler:core-libs {
    ...
};

let http = new scheduler:actions-http {
    "scheduler:core-libs/socket@0.1.0": core["scheduler:core-libs/socket@0.1.0"],
    "scheduler:core-libs/types@0.1.0": core["scheduler:core-libs/types@0.1.0"],
    ...
};

let scheduler = new scheduler:main {
    "scheduler:core-libs/types@0.1.0": core["scheduler:core-libs/types@0.1.0"],
    "scheduler:executor-types/types@0.1.0": http["scheduler:executor-types/types@0.1.0"],
    "scheduler:actions-http/http-component@0.1.0": http["scheduler:actions-http/http-component@0.1.0"],
    ...
};

export scheduler["run-scenario"];
