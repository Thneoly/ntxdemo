package ntx:packet;
use ntx:hostnet/types;
use ntx:hostnet/udp-socket-control;
use ntx:hostnet/resources;
/// Packet engine component that consumes RX packets via shared memories.
///
/// Note: WIT does not currently support exporting raw linear memories.
/// This world defines functions that expose two independent byte buffers
/// (`desc` and `payload`) which the host can treat as "memories".
///
/// When we need true multi-memory (core wasm `memory0/memory1`), we can switch
/// away from component model or add a custom adapter.
world packet-engine {
    import udp-socket-control;
    import resources;
    import types;
    /// Returns the current contents of the descriptor buffer.
    export desc-get: func() -> list<u8>;
    /// Overwrite a slice of the descriptor buffer at `off`.
    export desc-put: func(off: u32, data: list<u8>);

    /// Returns the current contents of the payload buffer.
    export payload-get: func() -> list<u8>;
    /// Overwrite a slice of the payload buffer at `off`.
    export payload-put: func(off: u32, data: list<u8>);

    /// Notify guest that new RX descriptors are available.
    ///
    /// Returns number of packets consumed in this call.
    export notify-rx: func() -> u32;

    /// Drive a minimal end-to-end demo from within the guest.
    ///
    /// Expected behavior:
    /// - acquire resources
    /// - create + bind a UDP socket
    /// - send one UDP datagram containing only the application payload
    export run: func() -> result<_, string>;
}
