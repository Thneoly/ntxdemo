package ntx:hostnet;

interface resources {
    /// Canonical UUID string.
    use types.{ipv4-addr, mac-addr};

    type resource-id = string;

    /// Owner identity for a socket (also a ResourceId).
    type owner-id = resource-id;

    /// UDP identity allocated from a host pool (local ip/mac/udp-port).
    record udp-identity {
        local-ipv4: ipv4-addr,
        local-mac: mac-addr,
        local-udp-port: u16,
    }

    variant resource-error {
        invalid-argument,
        not-found,
        exhausted,
        other(string),
    }

    /// Allocate a new socket owner id and register it.
    create-socket-owner: func(name: string) -> result<owner-id, resource-error>;

    /// Allocate+pin a UDP port for this owner from pool.
    acquire-udp-port: func(pool: string, owner: owner-id) -> result<_, resource-error>;

    /// Allocate local udp identity (ip/mac/port) from pool.
    acquire-udp-identity: func(pool: string, owner: owner-id) -> result<udp-identity, resource-error>;

    /// Best-effort resolve peer MAC from IPv4 (e.g. ARP cache).
    resolve-peer-mac: func(peer-ipv4: ipv4-addr) -> result<mac-addr, resource-error>;

    /// Release a resource by id (best-effort).
    release-resource: func(rid: resource-id) -> result<_, resource-error>;

    resolve-udp-port: func(rid: resource-id) -> result<u16, resource-error>;
}


