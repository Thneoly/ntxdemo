package scheduler:actions-executor@0.2.0;
use scheduler:core-types/types@0.2.0 as core-types;
use scheduler:event-bus/event-bus@0.2.0;

/// actions-executor 暴露给 scheduler 的执行接口。
interface action-component {
    use core-types.{action-def, action-outcome};

    init-component: func() -> result<_, string>;

    /// 执行一个 action。
    /// - action 已经在 scheduler 侧完成模板展开。
    execute-action: func(action: action-def) -> result<action-outcome, string>;

    release-component: func() -> result<_, string>;
}

world action-executor-component {
    /// scheduler/eventbus 供执行器上报结果或日志
    import scheduler:event-bus/event-bus@0.2.0;

    export action-component;
}

