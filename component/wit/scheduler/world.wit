package ntx:scenario-scheduler@0.1.0;

use ntx:scenario-actions-executor/action-component@0.1.0;
use ntx:scenario-eventbus/event-bus@0.1.0;
use ntx:hostnet/udp-socket-control@0.1.0;

/// Scheduler 主循环入口
interface scheduler-component {
    /// config-dir 指向 workflow/workbook/load 的所在目录
    run: func(config-dir: string) -> result<_, string>;
}

/// 接收 host 共享内存中的 RX ring 通知（参考 packet-engine 的 drain_rx_ring）。
interface packet-ingest {
    /// 解析 desc/payload buffer，返回消费的条目数。
    notify-rx: func(desc-mem: list<u8>, payload-mem: list<u8>) -> result<u32, string>;
}

/// 处理 executor 发出的发包请求事件（packet.tx-request），由 scheduler 调用 host 发送。
interface packet-tx {
    process-tx-request: func(payload-json: string) -> result<_, string>;
}

/// 发包调度接口（actions-executor 可委托 scheduler 周期/限速发送）
interface send-scheduler {
    record periodic {
        interval-ms: u64,
        start-delay-ms: option<u64>,
    }

    record timetable {
        timestamps: list<u64>,
    }

    record rate-limit {
        pps: u32,
        burst-size: option<u32>,
    }

    record sequence-payload {
        template: list<u8>,
        start-seq: u32,
    }

    variant send-schedule {
        once,
        periodic(periodic),
        timetable(timetable),
        rate-limited(rate-limit),
    }

    variant payload-generator {
        fixed(list<u8>),
        sequence(sequence-payload),
        timestamp(list<u8>),
    }

    record send-request {
        request-id: string,
        task-id: string,
        user-id: string,
        socket-id: u64,
        schedule: send-schedule,
        payload-generator: option<payload-generator>,
        max-count: option<u32>,
        timeout-ms: option<u64>,
    }

    variant send-request-state {
        pending,
        active,
        paused,
        completed,
        cancelled,
        error,
    }

    record send-status {
        request-id: string,
        state: send-request-state,
        total-sent: u32,
        last-sent-time: option<u64>,
        next-send-time: option<u64>,
    }

    schedule-send: func(request: send-request) -> result<string, string>;
    cancel-send: func(request-id: string) -> result<_, string>;
    query-send-status: func(request-id: string) -> result<send-status, string>;
}

world scheduler-main {
    import action-component;
    import event-bus;
    import ntx:hostnet/udp-socket-control@0.1.0;
    export scheduler-component;
    export packet-ingest;
    export packet-tx;
    export send-scheduler;
}

