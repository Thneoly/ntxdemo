package ntx:host;

/// 基础网络类型
interface types {
    record ipv4-addr { a: u8, b: u8, c: u8, d: u8 }
    record mac-addr { a: u8, b: u8, c: u8, d: u8, e: u8, f: u8 }
}

/// 资源分配接口（IP/Port 等）
interface resources {
    use types.{ipv4-addr, mac-addr};

    type resource-id = string;
    type owner-id = resource-id;

    /// UDP “身份”资源：由 host 从资源池动态分配 local ip/mac/udp-port。
    record udp-identity {
        local-ipv4: ipv4-addr,
        local-mac: mac-addr,
        local-udp-port: u16,
    }

    variant resource-error {
        invalid-argument,
        not-found,
        exhausted,
        other(string),
    }

    create-socket-owner: func(name: string) -> result<owner-id, resource-error>;
    acquire-udp-port: func(pool: string, owner: owner-id) -> result<_, resource-error>;
    acquire-udp-identity: func(pool: string, owner: owner-id) -> result<udp-identity, resource-error>;
    /// Best-effort resolve peer MAC from IPv4 (e.g. ARP cache lookup).
    /// Returns not-found if the host has no neighbor/ARP entry.
    resolve-peer-mac: func(peer-ipv4: ipv4-addr) -> result<mac-addr, resource-error>;
    release-resource: func(rid: resource-id) -> result<_, resource-error>;
    resolve-udp-port: func(rid: resource-id) -> result<u16, resource-error>;
}

/// UDP 控制接口
interface udp-socket-control {
    use types.{ipv4-addr, mac-addr};
    type resource-id = string;
    type sock-id = u64;

    record udp-socket {
        owner: resource-id,
        sock: sock-id,
    }

    record udp-bind {
        local-ipv4: ipv4-addr,
        local-mac: mac-addr,
        local-udp-port: u16,
        peer-ipv4: ipv4-addr,
        peer-port: u16,
        peer-mac: mac-addr,
        ttl: option<u8>,
    }

    record frame-handle {
        region: u32,
        offset: u32,
        len: u32,
    }

    variant socket-error {
        invalid-argument,
        invalid-state,
        not-found,
        no-space,
        other(string),
    }

    create: func(name: string) -> result<udp-socket, socket-error>;
    bind: func(sock: sock-id, b: udp-bind) -> result<_, socket-error>;
    build-reply: func(sock: sock-id, payload: list<u8>) -> result<frame-handle, socket-error>;
    tx: func(frame: frame-handle) -> result<u32, socket-error>;
}

world hostnet {
    // The guest imports these host-provided interfaces.
    import types;
    import resources;
    import udp-socket-control;
    export types;
    export resources;
    export udp-socket-control;
}

