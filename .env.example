# Ntx local environment configuration for scripts/install.sh
# This file is read automatically (repo root). Already-exported env vars take precedence.
#
# Harbor / ORAS settings
HARBOR_REGISTRY=192.168.31.138
WASM_TAG=v0.0.1
WASM_ARTIFACT_TYPE=application/vnd.ntx.wasm.v1

# If Harbor uses a self-signed cert, set the CA file path here.
# Example:
HARBOR_CA_FILE=/home/cc/Desktop/harbor/certs/harbor.crt

# Optional registry auth
HARBOR_USER=admin
HARBOR_PASS=Harbor12345

# ORAS TLS knobs (use only if you know what you're doing)
# ORAS_INSECURE=1
# ORAS_PLAIN_HTTP=1

# Install location
NTX_INSTALL_DIR=/opt/ntx

# Frontend
# Set to 0 if you want install to build the frontend.
SKIP_FRONTEND_BUILD=0
