# syntax=docker/dockerfile:1

FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/demo-workflow/package.json frontend/demo-workflow/package-lock.json ./
RUN npm ci

COPY frontend/demo-workflow/ ./

# Frontend uses VITE_NTX_BACKEND_URL at build time.
ARG VITE_NTX_BACKEND_URL=http://127.0.0.1:9090
ENV VITE_NTX_BACKEND_URL=$VITE_NTX_BACKEND_URL

RUN npm run build


FROM nginx:1.27-alpine AS runtime

COPY .build/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
